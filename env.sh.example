# env.sh — source this before running any FlexoGraph scripts
# Copy this file to env.sh and fill in your paths:
#   cp env.sh.example env.sh
#   vim env.sh
#   source env.sh

# Path to the FlexoGraph project root
export FLEXOGRAPH_PROJECT_DIR="/path/to/flexograph"

# Directory containing dataset subdirectories (e.g., kgs/, graph500_26/, etc.)
export FLEXOGRAPH_DATA_DIR="/path/to/datasets"

# Directory where WiredTiger databases are created
export FLEXOGRAPH_DB_DIR="/path/to/db"

# Directory for log files
export FLEXOGRAPH_LOG_DIR="/path/to/logs"

# (Optional) Path to the Kronecker graph generator binary
# export FLEXOGRAPH_KRON_GEN="/path/to/PaRMAT/Release/PaRMAT"
